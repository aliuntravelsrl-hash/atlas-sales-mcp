MCP_AUTH_TOKEN=
HOTEL_GALLERY_WEBHOOK_PATH=/webhook/hotel-galeria
POST_CREATIVO_WEBHOOK_PATH=/webhook/generar-post-creativo
BUSCAR_HOTELES_WEBHOOK_PATH=/webhook/buscar-hoteles
SESSION_TTL_MS=1800000
